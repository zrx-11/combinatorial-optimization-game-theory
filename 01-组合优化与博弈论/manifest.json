    },
    {
      "term": "NP-难",
      "def": "所有 NP 问题都能归约到它，自身可不在 NP 内",
      "chapterId": "ch05"
    },
    {
      "term": "归约",
      "def": "把 A 的实例改写成 B 的实例且答案一致",
