  "glossary": [
    {
      "term": "决策变量",
      "def": "你能拍板决定的那个量",
      "chapterId": "ch00"
    },
    {
      "term": "目标函数",
      "def": "你想让它变大或变小的那个数",
      "chapterId": "ch00"
    },
    {
      "term": "约束条件",
      "def": "决策变量必须满足的限制",
      "chapterId": "ch00"
    },
    {
      "term": "可行解",
      "def": "同时满足所有约束的一组取值",
      "chapterId": "ch00"
    },
    {
      "term": "可行域",
      "def": "所有可行解组成的集合",
      "chapterId": "ch00"
    },
    {
      "term": "最优解",
      "def": "可行域里让目标函数最好的一组取值",
      "chapterId": "ch00"
    },
    {
      "term": "最优值",
      "def": "最优解对应的目标函数数值",
      "chapterId": "ch00"
    },
    {
      "term": "局部最优",
      "def": "只比附近解好、全局未必最好的解",
      "chapterId": "ch00"
    },
    {
      "term": "标准形",
      "def": "最大化、等式约束、变量非负的规范形式",
      "chapterId": "ch01"
    },
    {
      "term": "基本可行解",
      "def": "非基变量取 0 且所有变量非负的解",
      "chapterId": "ch01"
    },
    {
      "term": "顶点",
      "def": "可行域多面体的角点，对应一个基本可行解",
      "chapterId": "ch01"
    },
    {
      "term": "检验数",
      "def": "让某个非基变量增加 1 单位时目标的改善量",
      "chapterId": "ch01"
    },
    {
      "term": "退化",
      "def": "基本可行解里有基变量取值为 0",
      "chapterId": "ch01"
    },
    {
      "term": "对偶问题",
      "def": "与原 LP 共用数据、角色互换的影子问题",
      "chapterId": "ch01"
    },
    {
      "term": "影子价格",
      "def": "每多一单位资源时最优目标的增量",
      "chapterId": "ch01"
    },
    {
      "term": "互补松弛",
      "def": "变量为正则约束紧，约束松则变量为 0",
      "chapterId": "ch01"
    },
    {
      "term": "全么模",
      "def": "所有方子阵行列式为 0 或正负 1 的矩阵",
      "chapterId": "ch02"
    },
    {
      "term": "位势",
      "def": "运输问题里对偶变量的别称",
      "chapterId": "ch02"
    },
    {
      "term": "闭回路",
      "def": "运输表里用于调整运量的闭合折线",
      "chapterId": "ch02"
    },
    {
      "term": "匈牙利算法",
      "def": "求指派问题最优解的逐轮减补法",
      "chapterId": "ch02"
    },
    {
      "term": "稳定匹配",
      "def": "不存在双方都想换的配对",
      "chapterId": "ch02"
    },
    {
      "term": "LP 松弛",
      "def": "把整数约束放掉后得到的线性规划",
      "chapterId": "ch03"
    },
    {
      "term": "割平面",
      "def": "只切掉分数顶点、保留所有整数解的约束",
