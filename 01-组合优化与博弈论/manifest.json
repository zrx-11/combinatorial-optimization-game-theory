    },
    {
      "term": "伪多项式算法",
      "def": "运行时间依赖数值大小而非规模的算法",
      "chapterId": "ch05"
    },
    {
      "term": "近似比",
      "def": "算法解与最优解之比的最坏上界",
      "chapterId": "ch05"
    },
    {
      "term": "PTAS",
      "def": "任意精度、精度固定时多项式时间的算法族",
      "chapterId": "ch05"
    },
    {
      "term": "FPTAS",
      "def": "对精度倒数值也是多项式的 PTAS",
