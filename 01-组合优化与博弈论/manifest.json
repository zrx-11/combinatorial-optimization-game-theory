    },
    {
      "term": "NP",
      "def": "解能在多项式时间内被验证的问题类",
      "chapterId": "ch05"
    },
    {
      "term": "NP-完全",
      "def": "NP 中最难的一类，所有 NP 问题都能归约到它",
