  "quizzes": [
    {
      "id": "q01",
      "chapterId": "ch00",
      "type": "single",
      "question": "一个优化问题的三件套是",
      "options": [
        "变量、数据、结果",
        "决策变量、目标函数、约束条件",
        "模型、算法、程序",
        "输入、处理、输出"
      ],
      "answer": 1,
      "explain": "三件套回答：能决定什么、好在哪、不能违反什么。"
    },
    {
      "id": "q02",
      "chapterId": "ch00",
      "type": "blank",
      "question": "比附近所有解都好、但全局还有更好解的那个解，叫______。",
      "answer": "局部最优解",
      "explain": "局部最优只看邻域，登山式搜索可能停在半山腰。"
    },
    {
      "id": "q03",
      "chapterId": "ch01",
      "type": "single",
      "question": "单纯形法每一步做的事是",
      "options": [
        "在可行域内部随机取点",
        "沿边从当前顶点走到相邻顶点",
        "把约束全部删掉",
        "用启发式搜索"
      ],
      "answer": 1,
      "explain": "顶点对应基本可行解，单纯形法在顶点间沿边移动，直到所有检验数不大于 0。"
    },
    {
      "id": "q04",
      "chapterId": "ch01",
      "type": "blank",
      "question": "检验数大于 0 表示把对应非基变量增大时，目标函数会______。",
      "answer": "变好",
      "explain": "检验数就是该变量增加 1 单位带来的目标增量。"
    },
    {
      "id": "q05",
      "chapterId": "ch02",
      "type": "single",
      "question": "产销平衡运输问题的约束矩阵秩为",
      "options": [
        "m + n",
        "m + n − 1",
        "mn",
        "mn − 1"
      ],
      "answer": 1,
      "explain": "m+n 个方程中有一组线性相关，因为总供给等于总需求。"
    },
    {
      "id": "q06",
      "chapterId": "ch02",
      "type": "single",
      "question": "匈牙利算法每一轮的核心动作是",
      "options": [
        "随机重排矩阵",
        "行减最小值、列减最小值，再用最少直线覆盖零",
        "直接取每行最大元素",
        "求矩阵的逆"
      ],
      "answer": 1,
      "explain": "减出零、覆盖零、找最小未覆盖元素补差，直到能选出 n 个互不同行同列的零。"
    },
    {
      "id": "q07",
      "chapterId": "ch03",
      "type": "single",
      "question": "对最大化问题，LP 松弛的最优值相对于整数最优值",
      "options": [
        "更小",
        "更大或相等，是上界",
        "一定相等",
        "无法比较"
      ],
      "answer": 1,
      "explain": "松弛扩大了可行域，最大值只会变大或不变，因此是剪枝依据。"
    },
    {
      "id": "q08",
      "chapterId": "ch03",
      "type": "blank",
      "question": "Gomory 割平面切掉的只是当前的______顶点，不切掉任何整数可行解。",
      "answer": "分数",
      "explain": "割由右端项为分数的那一行推出，所有整数解都满足。"
    },
    {
      "id": "q09",
      "chapterId": "ch04",
      "type": "single",
      "question": "最大流最小割定理说的是",
      "options": [
        "最大流等于所有边容量之和",
        "最大流的值等于最小割的容量",
        "最大流等于最短路径长度",
        "最小割等于顶点数"
      ],
      "answer": 1,
      "explain": "网络优化最核心的对偶结论：maxflow = mincut。"
    },
    {
      "id": "q10",
      "chapterId": "ch04",
      "type": "single",
      "question": "匹配 M 是最大匹配的充要条件是",
      "options": [
        "M 的边数等于顶点数的一半",
        "不存在增广路",
        "每条边权相等",
        "图是二分图"
      ],
      "answer": 1,
      "explain": "Berge 定理：有增广路就能翻转出更大的匹配。"
    },
    {
      "id": "q11",
      "chapterId": "ch05",
      "type": "single",
      "question": "要证明问题 B 是 NP-完全的，归约方向是",
      "options": [
        "把 B 改写成 A",
        "把已知 NP-完全的 A 改写成 B",
        "任选方向都行",
        "不需要归约"
      ],
      "answer": 1,
      "explain": "要说明 B 至少和 A 一样难，须把已知难的 A 归约到 B。"
    },
    {
      "id": "q12",
      "chapterId": "ch05",
      "type": "blank",
      "question": "强 NP-完全问题不存在______时间算法（在 P 不等于 NP 的前提下）。",
      "answer": "伪多项式",
      "explain": "定理 5.2，这也是背包有 O(nC) 的 DP 而 TSP 与装箱没有的原因。"
    },
    {
      "id": "q13",
      "chapterId": "ch06",
      "type": "single",
      "question": "单机、无约束、最小化总完工时间的最优算法是",
      "options": [
        "EDD",
        "SPT",
        "LPT",
        "Johnson 规则"
      ],
      "answer": 1,
      "explain": "按加工时间从短到长排，交换论证可证。"
    },
    {
      "id": "q14",
      "chapterId": "ch06",
      "type": "blank",
      "question": "P 台同型并行机上 LPT 的最坏情况界是______。",
      "answer": "4/3 − 1/(3m)",
